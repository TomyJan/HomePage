{
  "name": "tomyjan-homepage",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist",
  "nodeVersion": "24.18.0",
  "redirects": [
    {
      "source": "/pay.php*",
      "destination": "/pay.html?from=old_paycode",
      "statusCode": 301
    },
    {
      "source": "/feed*",
      "destination": "https://donate.tomys.top/?from=old_feed",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/_astro/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
