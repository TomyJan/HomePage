---
import { privacyPolicy } from '../data/site';
import PrivacyContent from './PrivacyContent.astro';
---

<section
  class="cookie-notice"
  id="cookie-notice"
  aria-label="Cookie 与隐私提示"
  hidden
  inert
>
  <div class="cookie-copy">
    <p>
      本站使用 Cookie 及类似技术保障基本功能。详情请查阅
      <a href="/privacy.html" data-privacy-link>
        隐私政策
      </a>
      。
    </p>
  </div>
  <div class="cookie-actions">
    <button class="privacy-action" id="cookie-confirm" type="button">
      知道了
    </button>
  </div>
</section>
<dialog
  class="privacy-sheet privacy-dialog"
  id="privacy-dialog"
  aria-labelledby="privacy-title"
>
  <div class="privacy-heading">
    <div>
      <h2 id="privacy-title">隐私政策</h2>
      <p class="privacy-date">更新于 {privacyPolicy.updated}</p>
    </div>
    <button
      class="privacy-close"
      type="button"
      id="privacy-close"
      aria-label="关闭隐私政策"
      autofocus
    >
      <svg class="icon" aria-hidden="true">
        <use href="#i-close" />
      </svg>
    </button>
  </div>
  <div class="privacy-scroll" tabindex="0" aria-label="隐私政策正文">
    <PrivacyContent />
  </div>
</dialog>
