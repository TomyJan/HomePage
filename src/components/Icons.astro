---
import { icons, iconLicense } from '../lib/icons';
---

<svg
  class="icon-defs"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <metadata>{iconLicense}</metadata>
  <defs>
    {icons.map(({ name, viewBox, content }) => (
      <symbol id={`i-${name}`} viewBox={viewBox} set:html={content} />
    ))}
  </defs>
</svg>
