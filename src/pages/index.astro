---
import Icons from '../components/Icons.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import Loader from '../components/Loader.astro';
import Favicon from '../components/Favicon.astro';
import { resources, siteMetadata } from '../data/site';
import '../styles/home.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#101519" />
    <meta name="description" content={siteMetadata.description} />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteMetadata.title} />
    <meta property="og:description" content={siteMetadata.description} />
    <meta property="og:url" content={Astro.site?.href} />
    <Favicon />
    <title>{siteMetadata.title}</title>
    <noscript>
      <style>
        html .boot {
          display: none;
        }
        html .ui-layer,
        html .player-bar {
          opacity: 1;
        }
        html .scene video,
        html .controls,
        html .nav,
        html .filing,
        html .uptime {
          display: none;
        }
        html .stage {
          min-height: 100dvh;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Icons />
    <main class="stage" id="stage" aria-busy="false">
      <div class="scene" aria-hidden="true">
        <div class="fallback">
          <img
            class="fallback-image"
            alt=""
            decoding="async"
            fetchpriority="low"
          />
        </div>
        <video
          id="scene-video"
          autoplay
          muted
          loop
          playsinline
          controlslist="nodownload nofullscreen noremoteplayback"
          disablepictureinpicture
          disableRemotePlayback
          draggable="false"
          tabindex="-1"
          inert
          preload="none"
        ></video>
        <div class="scene-surface"></div>
      </div>
      <div class="ui-layer" id="ui-layer">
        <a class="brand" href="#home" aria-label="荼蘼 TomyJan">
          <img
            src={resources.avatar}
            crossorigin="anonymous"
            data-avatar
            width="30"
            height="30"
            alt=""
            decoding="async"
          />
          <span>荼蘼 TomyJan</span>
        </a>
        <Navigation />
        <Footer />
      </div>
      <Player />
      <Loader />
    </main>
    <noscript>
      <nav class="noscript-links" aria-label="网站入口">
        <a href="https://blog.tomys.top/">博客</a>
        <a href="https://auth.amoe.cc/">MoeAuth</a>
        <a href="https://github.com/TomyJan">GitHub</a>
      </nav>
    </noscript>
    <script is:inline>
      for (const id of ['ui-layer', 'player-bar']) {
        const element = document.getElementById(id);
        if (element) element.inert = true;
      }
      document.getElementById('stage')?.setAttribute('aria-busy', 'true');
    </script>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
