---
import Icons from '../components/Icons.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import Loader from '../components/Loader.astro';
import '../styles/home.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#101519" />
    <meta name="description" content="荼蘼 TomyJan 的小小据点。" />
    <link
      rel="icon"
      type="image/png"
      sizes="96x96"
      href="/avatar-favicon.png"
    />
    <title>荼蘼 TomyJan</title>
    <noscript>
      <style>
        .boot {
          display: none;
        }
        .ui-layer,
        .player-bar {
          opacity: 1;
        }
        .scene video,
        .controls,
        .nav {
          display: none;
        }
        .stage {
          min-height: 100dvh;
        }
        .ui-layer[inert] {
          pointer-events: auto;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Icons />
    <main class="stage" id="stage" aria-busy="true">
      <div class="scene" aria-hidden="true">
        <div class="fallback">
          <img
            class="fallback-image"
            alt=""
            decoding="async"
            fetchpriority="low"
          />
        </div>
        <video
          id="scene-video"
          autoplay
          muted
          loop
          playsinline
          controlslist="nodownload nofullscreen noremoteplayback"
          disablepictureinpicture
          disableRemotePlayback
          draggable="false"
          tabindex="-1"
          preload="none"
        ></video>
      </div>
      <div class="ui-layer" id="ui-layer" inert>
        <a class="brand" href="#home" aria-label="荼蘼 TomyJan">
          <img src="/avatar.png" width="30" height="30" alt="" />
          <span>荼蘼 TomyJan</span>
        </a>
        <Navigation />
        <Footer />
      </div>
      <Player />
      <Loader />
    </main>
    <noscript>
      <nav class="noscript-links" aria-label="网站入口">
        <a href="https://blog.tomys.top/">博客</a>
        <a href="https://auth.amoe.cc/">MoeAuth</a>
        <a href="https://github.com/TomyJan">GitHub</a>
      </nav>
    </noscript>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
