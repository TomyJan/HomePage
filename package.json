  "type": "module",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm verify:build"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0"
}
